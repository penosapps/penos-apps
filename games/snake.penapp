{
  "id": "snake",
  "name": "Змейка",
  "icon": "🐍",
  "width": 540,
  "height": 620,
  "html": "<div style='text-align:center;padding:12px;'><h2 style='margin:0 0 10px;color:#00ffcc;'>🐍 Змейка</h2><canvas id='snake' width='440' height='440' style='background:#0a0a12;border-radius:10px;display:block;margin:0 auto;box-shadow:0 0 20px rgba(0,255,200,0.2);'></canvas><div style='margin-top:14px;color:#ccc;font-size:16px;'>Счёт: <b id='score' style='color:#00ff88;'>0</b> &nbsp;|&nbsp; Рекорд: <b id='best' style='color:#ffb703;'>0</b></div></div>",
  "script": "const c=root.querySelector('#snake');const ctx=c.getContext('2d');const CELL=22;const COLS=20;let snake,dir,food,score,alive,speed,timer,started=false;const bestKey='penos_snake_best';let best=parseInt(localStorage.getItem(bestKey)||'0',10);function init(){snake=[{x:10,y:10},{x:9,y:10},{x:8,y:10}];dir={x:1,y:0};food=rnd();score=0;alive=true;speed=150;started=false;updateUI();draw();}function rnd(){while(true){const p={x:Math.floor(Math.random()*COLS),y:Math.floor(Math.random()*COLS)};if(!snake.some(s=>s.x===p.x&&s.y===p.y))return p;}}function updateUI(){root.querySelector('#score').textContent=score;root.querySelector('#best').textContent=best;}function draw(){ctx.fillStyle='#0a0a12';ctx.fillRect(0,0,c.width,c.height);ctx.fillStyle='#ff4a4a';ctx.beginPath();ctx.arc(food.x*CELL+CELL/2,food.y*CELL+CELL/2,CELL/2-2,0,Math.PI*2);ctx.fill();snake.forEach((p,i)=>{ctx.fillStyle=i===0?'#00ffcc':'#00ff88';ctx.fillRect(p.x*CELL+1,p.y*CELL+1,CELL-2,CELL-2);});}function step(){if(!alive||!started)return;const head={x:snake[0].x+dir.x,y:snake[0].y+dir.y};if(head.x<0||head.x>=COLS||head.y<0||head.y>=COLS){gameOver();return;}if(snake.some(p=>p.x===head.x&&p.y===head.y)){gameOver();return;}snake.unshift(head);if(head.x===food.x&&head.y===food.y){score++;updateUI();food=rnd();if(score%5===0&&speed>60){speed-=10;restart();}}else{snake.pop();}draw();}function restart(){if(timer)clearInterval(timer);timer=setInterval(step,speed);}function gameOver(){alive=false;started=false;clearInterval(timer);if(score>best){best=score;localStorage.setItem(bestKey,best);updateUI();}if(navigator.vibrate)navigator.vibrate([80,40,80]);}function turn(nx,ny){if(!started&&alive){started=true;restart();}if(dir.x===-nx&&dir.y===-ny)return;if(dir.x===nx&&dir.y===ny)return;dir={x:nx,y:ny};}document.onkeydown=(e)=>{if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.key))e.preventDefault();if(e.key==='ArrowUp')turn(0,-1);if(e.key==='ArrowDown')turn(0,1);if(e.key==='ArrowLeft')turn(-1,0);if(e.key==='ArrowRight')turn(1,0);};let tS=null;c.addEventListener('touchstart',(e)=>{e.preventDefault();tS={x:e.touches[0].clientX,y:e.touches[0].clientY};},{passive:false});c.addEventListener('touchend',(e)=>{e.preventDefault();if(!tS)return;const dx=e.changedTouches[0].clientX-tS.x;const dy=e.changedTouches[0].clientY-tS.y;if(Math.abs(dx)>Math.abs(dy)){turn(dx>0?1:-1,0);}else{turn(0,dy>0?1:-1);}tS=null;},{passive:false});c.addEventListener('click',()=>{if(!alive)init();else if(!started){started=true;restart();}});init();"
}
