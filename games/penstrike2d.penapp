{
  "id": "penstrike2d",
  "name": "PenStrike 2D",
  "icon": "🔫",
  "width": 780,
  "height": 620,
  "html": "<div style='display:flex;flex-direction:column;height:100%;background:#0a0a12;color:#fff;font-family:sans-serif;'><div style='display:flex;justify-content:space-between;padding:10px 16px;background:#15151f;border-bottom:2px solid #2a2a3a;'><div>❤️ HP: <b id='hp' style='color:#ff4a4a;'>100</b></div><div>💯 Очки: <b id='pts' style='color:#00ff88;'>0</b></div><div>🏆 Рекорд: <b id='hi' style='color:#ffb703;'>0</b></div></div><div id='arena' style='flex:1;position:relative;overflow:hidden;background:radial-gradient(ellipse at center,#1a1a2e 0%,#0a0a12 70%);cursor:crosshair;'></div></div>",
  "script": "const arena=root.querySelector('#arena');const hpEl=root.querySelector('#hp');const ptsEl=root.querySelector('#pts');const hiEl=root.querySelector('#hi');let hp,points,enemies,timerSpawn,timerLoop,alive;const best=parseInt(localStorage.getItem('penos_penstrike_best')||'0',10);hiEl.textContent=best;const TYPES=[{icon:'🎯',pts:10,hp:0,size:44,speed:1.2,color:'#ff4a4a'},{icon:'🤖',pts:20,hp:0,size:50,speed:1.8,color:'#00b4d8'},{icon:'👾',pts:30,hp:1,size:54,speed:2.2,color:'#ff00ff'},{icon:'💀',pts:50,hp:2,size:58,speed:2.8,color:'#ffb703'},{icon:'👹',pts:80,hp:3,size:64,speed:3.2,color:'#ff0033'}];function init(){hp=100;points=0;enemies=[];alive=true;arena.innerHTML='';updateUI();if(timerSpawn)clearInterval(timerSpawn);if(timerLoop)clearInterval(timerLoop);timerSpawn=setInterval(spawn,900);timerLoop=setInterval(loop,32);}function updateUI(){hpEl.textContent=Math.max(0,hp);ptsEl.textContent=points;}function spawn(){if(!alive)return;const diff=Math.min(4,Math.floor(points/300));const t=TYPES[Math.floor(Math.random()*(diff+1))];const e=document.createElement('div');const x=Math.random()*(arena.clientWidth-t.size-20)+10;const y=arena.clientHeight+60;e.style.cssText=`position:absolute;left:${x}px;top:${y}px;width:${t.size}px;height:${t.size}px;font-size:${t.size-10}px;display:flex;align-items:center;justify-content:center;filter:drop-shadow(0 0 8px ${t.color});user-select:none;cursor:crosshair;`;e.textContent=t.icon;const obj={el:e,type:t,hp:t.hp,x:x,y:y};e.addEventListener('mousedown',(ev)=>{ev.stopPropagation();shootAt(obj,ev);});enemies.push(obj);arena.appendChild(e);}function loop(){if(!alive)return;for(let i=enemies.length-1;i>=0;i--){const e=enemies[i];e.y+=e.type.speed;e.el.style.top=e.y+'px';if(e.y>arena.clientHeight){if(e.type.hp===0||e.hp>0){hp-=5;updateUI();}e.el.remove();enemies.splice(i,1);if(hp<=0)gameOver();}}}function shootAt(target,ev){if(!alive)return;const rect=arena.getBoundingClientRect();const mx=ev.clientX-rect.left;const my=ev.clientY-rect.top;const m=document.createElement('div');m.style.cssText=`position:absolute;left:${mx}px;top:${my}px;width:24px;height:24px;margin-left:-12px;margin-top:-12px;pointer-events:none;color:#ff4a4a;font-weight:bold;font-size:20px;text-align:center;line-height:24px;text-shadow:0 0 8px #ff4a4a;`;m.textContent='+';arena.appendChild(m);setTimeout(()=>m.remove(),400);if(target){target.hp--;if(target.hp<0){points+=target.type.pts;updateUI();target.el.style.transition='all 0.3s';target.el.style.transform='scale(1.5) rotate(45deg)';target.el.style.opacity='0';setTimeout(()=>target.el.remove(),300);const idx=enemies.indexOf(target);if(idx>=0)enemies.splice(idx,1);}}else{hp-=1;updateUI();}}function gameOver(){alive=false;clearInterval(timerSpawn);clearInterval(timerLoop);if(points>best){localStorage.setItem('penos_penstrike_best',points);hiEl.textContent=points;}if(navigator.vibrate)navigator.vibrate([100,50,100]);}arena.addEventListener('mousedown',(ev)=>{if(!alive)return;if(ev.target!==arena)return;shootAt(null,ev);});init();"
}
