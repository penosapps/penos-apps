{
  "id": "penstrike2d",
  "name": "PenStrike 2D",
  "icon": "🔫",
  "width": 380,
  "height": 640,
  "html": "<div id='game-root' style='display:flex;flex-direction:column;height:100%;background:#0a0a12;color:#fff;font-family:sans-serif;position:relative;overflow:hidden;'><div id='menu' style='position:absolute;inset:0;background:linear-gradient(135deg,#1a1a2e 0%,#0a0a12 100%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;z-index:200;'><div id='sound-btn' style='position:absolute;top:14px;right:14px;width:52px;height:52px;border-radius:50%;background:#24243a;border:2px solid #3a3a52;display:flex;align-items:center;justify-content:center;font-size:24px;cursor:pointer;transition:all 0.2s;box-shadow:0 4px 15px rgba(0,0,0,0.5);'>🔊</div><div style='font-size:80px;filter:drop-shadow(0 0 20px #00b4d8);animation:pulse 1.5s ease-in-out infinite;'>🔫</div><h1 style='margin:0;font-size:38px;color:#00ffcc;text-shadow:0 0 20px #00ffcc;letter-spacing:3px;'>PENSTRIKE</h1><div style='color:#888;font-size:14px;letter-spacing:6px;margin-top:-14px;'>2D EDITION</div><button id='play-btn' style='margin-top:24px;padding:16px 48px;font-size:20px;font-weight:bold;background:linear-gradient(135deg,#00b4d8,#0077b6);border:none;border-radius:12px;color:#fff;cursor:pointer;box-shadow:0 6px 30px rgba(0,180,216,0.5);transition:transform 0.15s;'>▶ ИГРАТЬ</button><div style='color:#666;font-size:12px;margin-top:10px;'>Тап по врагу = выстрел</div><div style='color:#666;font-size:11px;position:absolute;bottom:20px;'>v1.2 · PenOS Team</div></div><div id='hud' style='display:flex;justify-content:space-between;padding:10px 12px;background:#15151f;border-bottom:2px solid #2a2a3a;font-size:13px;z-index:50;'><div>❤️ <b id='hp' style='color:#ff4a4a;'>150</b></div><div>💯 <b id='pts' style='color:#00ff88;'>0</b></div><div>🏆 <b id='hi' style='color:#ffb703;'>0</b></div></div><div id='arena' style='flex:1;position:relative;overflow:hidden;background:radial-gradient(ellipse at center,#1a1a2e 0%,#0a0a12 70%);cursor:crosshair;'></div><style>@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.1)}}@keyframes hit{0%{opacity:1;transform:scale(0.5)}100%{opacity:0;transform:scale(1.5)}}</style></div>",
  "script": "const gameRoot=root.querySelector('#game-root');const arena=root.querySelector('#arena');const hpEl=root.querySelector('#hp');const ptsEl=root.querySelector('#pts');const hiEl=root.querySelector('#hi');const menu=root.querySelector('#menu');const playBtn=root.querySelector('#play-btn');const soundBtn=root.querySelector('#sound-btn');let hp,points,enemies,timerSpawn,timerLoop,alive,audioCtx=null,musicTimer=null,musicIdx=0;let soundOn=localStorage.getItem('penos_penstrike_sound')!=='off';const best=parseInt(localStorage.getItem('penos_penstrike_best')||'0',10);hiEl.textContent=best;const TYPES=[{icon:'🎯',pts:10,hp:0,size:52,speed:0.5,color:'#ff4a4a'},{icon:'🤖',pts:20,hp:0,size:56,speed:0.7,color:'#00b4d8'},{icon:'👾',pts:30,hp:1,size:60,speed:0.9,color:'#ff00ff'},{icon:'💀',pts:50,hp:2,size:64,speed:1.1,color:'#ffb703'},{icon:'👹',pts:80,hp:3,size:70,speed:1.4,color:'#ff0033'}];function getAudio(){if(!audioCtx){try{audioCtx=new(window.AudioContext||window.webkitAudioContext)();}catch(e){}}return audioCtx;}function beep(freq,duration,type,volume){if(!soundOn)return;const ctx=getAudio();if(!ctx)return;const osc=ctx.createOscillator();const gain=ctx.createGain();osc.type=type||'square';osc.frequency.value=freq;gain.gain.value=volume||0.08;gain.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+duration);osc.connect(gain);gain.connect(ctx.destination);osc.start();osc.stop(ctx.currentTime+duration);}function shootSound(){beep(680,0.07,'square',0.07);setTimeout(()=>beep(320,0.05,'square',0.05),40);}function hitSound(){beep(880,0.06,'square',0.08);setTimeout(()=>beep(1200,0.05,'square',0.06),50);}function missSound(){beep(180,0.1,'sawtooth',0.06);}function gameOverSound(){beep(400,0.15,'sawtooth',0.1);setTimeout(()=>beep(300,0.15,'sawtooth',0.1),150);setTimeout(()=>beep(200,0.4,'sawtooth',0.12),300);}function startMusic(){if(!soundOn)return;const ctx=getAudio();if(!ctx)return;const notes=[261.63,329.63,392.00,523.25,392.00,329.63,261.63,196.00];if(musicTimer)clearInterval(musicTimer);musicIdx=0;musicTimer=setInterval(()=>{if(!soundOn)return;const freq=notes[musicIdx%notes.length];const osc=ctx.createOscillator();const gain=ctx.createGain();osc.type='triangle';osc.frequency.value=freq;gain.gain.value=0.028;gain.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+0.35);osc.connect(gain);gain.connect(ctx.destination);osc.start();osc.stop(ctx.currentTime+0.4);musicIdx++;},420);}function stopMusic(){if(musicTimer){clearInterval(musicTimer);musicTimer=null;}}function updateSoundBtn(){soundBtn.textContent=soundOn?'🔊':'🔇';soundBtn.style.borderColor=soundOn?'#00b4d8':'#3a3a52';soundBtn.style.boxShadow=soundOn?'0 0 20px rgba(0,180,216,0.5)':'0 4px 15px rgba(0,0,0,0.5)';}function toggleSound(ev){if(ev)ev.preventDefault();soundOn=!soundOn;localStorage.setItem('penos_penstrike_sound',soundOn?'on':'off');updateSoundBtn();if(soundOn){beep(880,0.1,'sine',0.1);if(menu.style.display!=='none')startMusic();}else{stopMusic();}}function init(){hp=150;points=0;enemies=[];alive=true;arena.innerHTML='';updateUI();if(timerSpawn)clearInterval(timerSpawn);if(timerLoop)clearInterval(timerLoop);timerSpawn=setInterval(spawn,1500);timerLoop=setInterval(loop,32);setTimeout(spawn,300);if(soundOn)startMusic();}function updateUI(){hpEl.textContent=Math.max(0,hp);ptsEl.textContent=points;}function spawn(){if(!alive)return;const diff=Math.min(4,Math.floor(points/300));const t=TYPES[Math.floor(Math.random()*(diff+1))];const e=document.createElement('div');const maxX=Math.max(10,arena.clientWidth-t.size-20);const x=Math.random()*maxX+10;const y=-t.size;e.style.cssText=`position:absolute;left:${x}px;top:${y}px;width:${t.size}px;height:${t.size}px;font-size:${t.size-12}px;display:flex;align-items:center;justify-content:center;filter:drop-shadow(0 0 8px ${t.color});user-select:none;cursor:crosshair;`;e.textContent=t.icon;const obj={el:e,type:t,hp:t.hp,x:x,y:y};e.addEventListener('mousedown',(ev)=>{ev.stopPropagation();ev.preventDefault();shootAt(obj,ev);});e.addEventListener('touchstart',(ev)=>{ev.stopPropagation();ev.preventDefault();const t2=ev.touches[0];shootAt(obj,{clientX:t2.clientX,clientY:t2.clientY});},{passive:false});enemies.push(obj);arena.appendChild(e);}function loop(){if(!alive)return;for(let i=enemies.length-1;i>=0;i--){const e=enemies[i];e.y+=e.type.speed;e.el.style.top=e.y+'px';if(e.y>arena.clientHeight){if(e.hp>0){hp-=5;updateUI();}e.el.remove();enemies.splice(i,1);if(hp<=0)gameOver();}}}function shootAt(target,ev){if(!alive)return;shootSound();const rect=arena.getBoundingClientRect();const mx=ev.clientX-rect.left;const my=ev.clientY-rect.top;const m=document.createElement('div');m.style.cssText=`position:absolute;left:${mx}px;top:${my}px;width:26px;height:26px;margin-left:-13px;margin-top:-13px;pointer-events:none;color:#ff4a4a;font-weight:bold;font-size:24px;text-align:center;line-height:26px;text-shadow:0 0 10px #ff4a4a;animation:hit 0.4s ease-out;`;m.textContent='+';arena.appendChild(m);setTimeout(()=>m.remove(),400);if(target){target.hp--;if(target.hp<0){hitSound();points+=target.type.pts;updateUI();target.el.style.transition='all 0.3s';target.el.style.transform='scale(1.5) rotate(45deg)';target.el.style.opacity='0';setTimeout(()=>target.el.remove(),300);const idx=enemies.indexOf(target);if(idx>=0)enemies.splice(idx,1);if(navigator.vibrate)navigator.vibrate(20);}else{target.el.style.transform='scale(0.85)';setTimeout(()=>target.el.style.transform='scale(1)',80);}}else{missSound();hp-=1;updateUI();}}function gameOver(){alive=false;stopMusic();clearInterval(timerSpawn);clearInterval(timerLoop);gameOverSound();if(points>best){localStorage.setItem('penos_penstrike_best',points);hiEl.textContent=points;}const over=document.createElement('div');over.style.cssText='position:absolute;inset:0;background:rgba(0,0,0,0.9);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;color:#fff;z-index:100;padding:20px;text-align:center;';over.innerHTML=`<div style='font-size:34px;font-weight:bold;color:#ff4a4a;text-shadow:0 0 20px #ff4a4a;'>💀 ИГРА ОКОНЧЕНА</div><div style='font-size:24px;color:#00ff88;margin-top:8px;'>Очки: <b>${points}</b></div><div style='font-size:14px;color:#888;'>Рекорд: ${best}</div><button id='restart-btn' style='margin-top:18px;padding:14px 42px;font-size:17px;background:linear-gradient(135deg,#00b4d8,#0077b6);border:none;border-radius:10px;color:#fff;font-weight:bold;cursor:pointer;box-shadow:0 4px 20px rgba(0,180,216,0.5);'>🔄 ЗАНОВО</button>`;arena.appendChild(over);const btn=over.querySelector('#restart-btn');const restartFn=(ev)=>{if(ev)ev.preventDefault();over.remove();arena.innerHTML='';init();};btn.addEventListener('click',restartFn);btn.addEventListener('touchstart',restartFn,{passive:false});if(navigator.vibrate)navigator.vibrate([100,50,100]);}function startGame(){menu.style.display='none';init();}soundBtn.addEventListener('click',toggleSound);soundBtn.addEventListener('touchstart',toggleSound,{passive:false});playBtn.addEventListener('click',startGame);playBtn.addEventListener('touchstart',(ev)=>{ev.preventDefault();startGame();},{passive:false});arena.addEventListener('mousedown',(ev)=>{if(!alive)return;if(ev.target!==arena)return;shootAt(null,ev);});arena.addEventListener('touchstart',(ev)=>{if(!alive)return;if(ev.target!==arena)return;ev.preventDefault();const t2=ev.touches[0];shootAt(null,{clientX:t2.clientX,clientY:t2.clientY});},{passive:false});updateSoundBtn();if(soundOn){const startMenuMusic=()=>{if(soundOn&&menu.style.display!=='none'&&!musicTimer){startMusic();}document.removeEventListener('click',startMenuMusic);document.removeEventListener('touchstart',startMenuMusic);};document.addEventListener('click',startMenuMusic,{once:true});document.addEventListener('touchstart',startMenuMusic,{once:true});}"
}
